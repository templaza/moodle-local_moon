{{!
    @template local_moon/default

    Boost drawer template.

    Context variables required for this template:
    * sitename - The name of the site
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes
    * sidepreblocks - HTML for the blocks
    * hasblocks - true if there are blocks on this page
    * courseindexopen - true if the nav drawer should be open on page load
    * regionmainsettingsmenu - HTML for the region main settings menu
    * hasregionmainsettingsmenu - There is a region main settings menu on this page.

    Example context (json):
    {
        "sitename": "Moodle",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headings make html validators happier</h1>"
         },
        "bodyattributes":"",
        "sidepreblocks": "<h2>Blocks html goes here</h2>",
        "hasblocks":true,
        "courseindexopen": true,
        "navdraweropen": false,
        "blockdraweropen": true,
        "regionmainsettingsmenu": "",
        "hasregionmainsettingsmenu": false,
        "addblockbutton": ""
    }
}}
{{{ output.doctype }}}
<html {{{ output.htmlattributes }}} data-bs-theme="{{ document.get_theme_mode }}">
{{> local_moon/head }}
<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">
    {{{ output.standard_top_of_body_html }}}
    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers {{#courseindexopen}}show-drawer-left{{/courseindexopen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">
        <div id="topofscroll" class="moon-content">
            <div class="drawer-toggles d-flex">
                {{#courseindex}}
                    {{> local_moon/header/includes/courseindex }}
                {{/courseindex}}
            </div>
            <div id="page-content" class="d-print-block">
                <div id="region-main-box">
                    {{#hasregionmainsettingsmenu}}
                        <div id="region-main-settings-menu" class="d-print-none">
                            <div> {{{ regionmainsettingsmenu }}} </div>
                        </div>
                    {{/hasregionmainsettingsmenu}}
                    <div class="{{layout_container_class}}">
                        {{{sidebar_content}}}
                        <div class="{{layout_content_class}}">
                            {{{ layoutbuilder }}}
                        </div>
                    </div>
                </div>
                {{{ output.standard_after_main_region_html }}}
            </div>
        </div>
        {{{ output.standard_footer_html }}}
        {{{ output.edit_switch }}}
        {{{ document.renderFooter }}}
        {{#hasblocks}}
            <div class="moon-offcanvas offcanvas offcanvas-end" tabindex="-1" id="moon-offcanvas-sidepre" aria-labelledby="moon-offcanvas-sidepre-label" data-lenis-prevent>
                <div class="offcanvas-header burger-menu-button">
                    <h5 class="offcanvas-title" id="moon-offcanvas-sidepre-label">Menu</h5>
                    <button type="button" class="button close-offcanvas offcanvas-close-btn" data-bs-dismiss="offcanvas" aria-label="Close">
                        <span class="box">
                            <span class="inner">
                                <span class="visually-hidden">{{#str}}opendrawerblocks, core{{/str}}</span>
                            </span>
                        </span>
                    </button>
                </div>
                <div class="offcanvas-body">
                    <div class="d-print-none">
                        {{{ addblockbutton }}}
                        {{{ sidepreblocks }}}
                    </div>
                </div>
            </div>
        {{/hasblocks}}
        {{#courseindex}}
            <div class="moon-offcanvas offcanvas offcanvas-start" tabindex="-1" id="moon-offcanvas-courseindex" aria-labelledby="moon-offcanvas-courseindex-label" data-lenis-prevent>
                <div class="offcanvas-header burger-menu-button">
                    <h5 class="offcanvas-title" id="moon-offcanvas-courseindex-label">{{> theme_boost/courseindexdrawerheading}}</h5>
                    <button type="button" class="button close-offcanvas offcanvas-close-btn" data-bs-dismiss="offcanvas" aria-label="Close">
                        <span class="box">
                            <span class="inner">
                                <span class="visually-hidden">{{#str}}opendrawerblocks, core{{/str}}</span>
                            </span>
                        </span>
                    </button>
                </div>
                <div class="offcanvas-body">
                    {{> theme_boost/courseindexdrawercontrols}}
                    {{{ courseindex }}}
                </div>
            </div>
        {{/courseindex}}
        <div class="footer-content-debugging footer-dark bg-dark text-light">
            <div class="container-fluid footer-dark-inner">
                {{{ output.debug_footer_html }}}
            </div>
        </div>
    </div>
    {{{ output.standard_end_of_body_html }}}
</div>
<div class="moon-breakpoints d-none"><div class="d-block d-sm-none device-xs"></div><div class="d-none d-sm-block d-md-none device-sm"></div><div class="d-none d-md-block d-lg-none device-md"></div><div class="d-none d-lg-block d-xl-none device-lg"></div><div class="d-none d-xl-block device-xl"></div></div>
</body>
</html>
