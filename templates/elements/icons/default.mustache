{{!
    @template local_moon/elements/icons/default
    This template renders the icons widget.
}}
<div class="icons-group d-flex" role="group">
{{#icons}}
    {{#has_link}}<a id="{{id}}" href="{{link}}" class="moon-icon d-flex align-items-center justify-content-center"{{link_target}}>{{#has_icon}}<i class="{{icon}}"></i>{{/has_icon}}{{title}}</a>{{/has_link}}
    {{^has_link}}<div id="{{id}}" class="moon-icon d-flex align-items-center justify-content-center">{{#has_icon}}<i class="{{icon}}"></i>{{/has_icon}}{{title}}</div>{{/has_link}}
{{/icons}}
</div>