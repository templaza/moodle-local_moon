{{!
    @template local_moon/elements/list/default
    This template renders the list widget.
}}
{{#has_heading}}
    <h3 class="list-heading">{{{heading}}}</h3>
{{/has_heading}}
<{{tag}} class="{{class}}">
{{#lists}}
    {{#is_list_description}}
        <dt class="as-list-title as-list-icon col-{{title_width}}">{{#has_icon}}<i class="{{icon}} me-2"></i>{{/has_icon}}{{{title}}}</dt>
        <dd class="as-list-desc col-{{description_width}}">{{{description}}}</dd>
    {{/is_list_description}}
    {{#is_list_custom}}
        <li id="tzlist-{{id}}" class="{{class_item}}">
            <div class="list-item-inner uk-flex{{class_item_inner}} {{vertical_align}}">
                {{#has_icon}}<div class="as-list-icon"><i class="{{icon}}"></i></div>{{/has_icon}}
                <div class="list-item-info">
                    {{#has_title}}<{{title_html_element}} class="as-list-title">{{{title}}}</{{title_html_element}}>{{/has_title}}
                    {{#has_description}}<div class="as-list-desc">{{{description}}}</div>{{/has_description}}
                </div>
            </div>
        </li>
    {{/is_list_custom}}
    {{#is_list_inline}}
        <li id="tzlist-{{id}}" class="{{class_item}}">
            <div class="list-item-inner uk-flex{{class_item_inner}} uk-child-1-3@m uk-grid-collapse" data-uk-grid>
                {{#has_icon}}<div class="as-list-icon uk-width-auto"><i class="{{icon}} me-2"></i></div>{{/has_icon}}
                {{#has_title}}<{{title_html_element}} class="uk-width-auto as-list-title">{{{title}}}</{{title_html_element}}>{{/has_title}}
                {{#has_description}}<div class="as-list-desc uk-width-expand@m">{{{description}}}</div>{{/has_description}}
            </div>
        </li>
    {{/is_list_inline}}
    {{#is_list_others}}
        <li class="{{class_item}}">
            <div class="list-item-inner{{class_item_inner}}">
                {{#has_title}}<{{title_html_element}} class="as-list-title as-list-icon">{{#has_icon}}<i class="{{icon}} me-2"></i>{{/has_icon}}{{{title}}}</{{title_html_element}}>{{/has_title}}
                {{#has_description}}<div class="as-list-desc">{{{description}}}</div>{{/has_description}}
            </div>
        </li>
    {{/is_list_others}}
{{/lists}}
</{{tag}}>