{{!
    @template local_moon/elements/heading/default
    This template renders the heading widget.
}}
{{#has_title}}
    {{#is_meta_before}}<div class="heading-meta {{meta_class}}">{{meta}}</div>{{/is_meta_before}}
    {{#has_link}}<a href="{{link}}" title="{{title}}">{{/has_link}}
        <{{html_element}} class="heading">{{#has_icon}}<i class="{{icon}} moon-icon me-2"></i>{{/has_icon}}{{title}}</{{html_element}}>
    {{#has_link}}</a>{{/has_link}}
    {{#has_title_clone}}<div class="heading-clone position-absolute">{{title_clone_txt}}</div>{{/has_title_clone}}
    {{#is_meta_after}}<div class="heading-meta {{meta_class}}">{{meta}}</div>{{/is_meta_after}}
{{/has_title}}