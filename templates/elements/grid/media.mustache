{{!
    @template local_moon/elements/grid/media
    This template renders the grid media.
}}
{{#is_image}}
    {{#has_link}}<a href="{{link}}"{{link_target}} class="{{link_class}}">{{/has_link}}
        <div class="{{image_cover_class}}">
            {{#is_overlay}}<div class="as-image-cover moon-image-overlay-cover">{{/is_overlay}}
            <img class="{{image_class}}" src="{{image}}" alt="{{title}}">
            {{#is_overlay}}</div>{{/is_overlay}}
            {{#enable_image_cover}}
                {{#content_hover_transition}}<div class="card-img-overlay uk-transition-fade"></div>{{/content_hover_transition}}
                {{^content_hover_transition}}<div class="card-img-overlay"></div>{{/content_hover_transition}}
            {{/enable_image_cover}}
        </div>
    {{#has_link}}</a>{{/has_link}}
{{/is_image}}
{{#is_icon}}
    {{#has_link}}<a href="{{link}}"{{link_target}} class="{{link_class}}">{{/has_link}}
        <div class="moon-icon-wrapper"><i class="{{icon_class}}"></i></div>
    {{#has_link}}</a>{{/has_link}}
{{/is_icon}}